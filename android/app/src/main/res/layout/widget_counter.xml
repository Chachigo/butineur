<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/counter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Emoji or Phosphor glyph: only one of the two is ever visible. -->
    <TextView
        android:id="@+id/counter_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textSize="20sp" />

    <ImageView
        android:id="@+id/counter_icon_img"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- One line, shrinking if it has to: on a dense grid the cell is narrow,
         and a long name or unit used to wrap. Auto-sizing is API 26+, below
         that only ellipsizing is left — no wrapping in either case.
         ponytail: no per-widget-size layout (responsive RemoteViews, API 31+);
         only worth it if shrinking stops being enough. -->
    <TextView
        android:id="@+id/counter_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/counter_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/counter_plus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_btn_go"
        android:contentDescription="@string/widget_plus"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="@color/widget_go_ink"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
