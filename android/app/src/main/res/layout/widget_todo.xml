<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/todo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_todo_title"
            android:textColor="@color/widget_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todo_new"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_todo_new"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_go"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/todo_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_todo_empty"
        android:textColor="@color/widget_dim"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/todo_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="4dp" />
</LinearLayout>
