<?xml version="1.0" encoding="utf-8"?>
<!--
  Icône de notification : Android n'en garde que la silhouette, tout doit donc
  être opaque et lisible en 24 dp. Abdomen en trois bandes de largeur
  décroissante — c'est ce qui fait lire « abeille » sans couleur.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Ailes -->
    <group
        android:pivotX="6.2"
        android:pivotY="8.4"
        android:rotation="-28">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M2.6,8.4 a3.6,2.1 0 1,0 7.2,0 a3.6,2.1 0 1,0 -7.2,0" />
    </group>
    <group
        android:pivotX="17.8"
        android:pivotY="8.4"
        android:rotation="28">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M14.2,8.4 a3.6,2.1 0 1,0 7.2,0 a3.6,2.1 0 1,0 -7.2,0" />
    </group>

    <!-- Antennes -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:pathData="M10.6,4.3 L9.1,2.4" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:pathData="M13.4,4.3 L14.9,2.4" />

    <!-- Tête -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.6,6.2 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0" />

    <!-- Abdomen rayé -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7.4,9.9 a4.6,1.6 0 1,0 9.2,0 a4.6,1.6 0 1,0 -9.2,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8.0,13.3 a4.0,1.6 0 1,0 8.0,0 a4.0,1.6 0 1,0 -8.0,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.1,16.5 a2.9,1.5 0 1,0 5.8,0 a2.9,1.5 0 1,0 -5.8,0" />
